# Google AI Studio key for "Read next" and the year summary (https://aistudio.google.com/apikey).
# Put your real key in .env.local, never in this file: this one is committed to GitHub.
# Without a key the app still works; the AI features show a friendly "not set up" message.
GEMINI_API_KEY=

# Optional: the main model and the fallbacks tried when it's busy or slow.
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-2.5-flash
